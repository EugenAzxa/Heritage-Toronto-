# Vendored third-party skill pack (~8 MB). Not part of the site.
# Reinstall with:
#   git clone --depth 1 https://github.com/nextlevelbuilder/ui-ux-pro-max-skill
#   cp -r ui-ux-pro-max-skill/.claude/skills/* .claude/skills/
.claude/skills/

# Raw source photos (large originals; web-ready copies live in /assets)
*.HEIC
Albert+jackson.jpg.webp
albert_jackson_postman.jpg
albertjacksonstamp.jpg
e010963829-v8.jpg

# HyperFrames video project (videos/): keep the source composition, the
# vendored fonts and the finished MP4. The rest is regenerable:
#   capture/   re-run `hyperframes capture` against the running site
#   snapshots/ re-run `hyperframes snapshot`
videos/*/capture/
videos/*/snapshots/
videos/*/.hyperframes/
videos/*/.thumbnails/
